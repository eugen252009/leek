fn minus1(x u32) u32 { return x - 1 }
fn divide_12_by(x u32) u32 { return 12 / x }

fn calculate(x u32) u32 {
    if x > 1 {
        return x -> minus1 -> divide_12_by
    }
    return 0
}

fn local_calculate(x u32) u32 {
    if x > 1 {
        let denominator u32 = x - 1
        return 12 / denominator
    }
    return 0
}

fn bounded_add(x u32) u32 {
    if x <= 100 {
        return x + 5
    }
    return 0
}

fn still_checked(x u32) u32 {
    if x > 0 {
        return x * x
    }
    return 0
}

impure fn main() {
    print(calculate(2))
    print(local_calculate(2))
    print(bounded_add(100))
}
